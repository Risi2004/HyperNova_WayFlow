# WayFlow Backend Environment Configuration
PORT=5000

# Neon Serverless PostgreSQL Connection String
# Example: postgresql://username:password@ep-cool-frost-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Email Configuration (for automated welcome & temporary credential dispatch)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_gmail_app_password
EMAIL_FROM="WayFlow Operations" <no-reply@wayflow.internal>

# Deployed Frontend Application URL (used in automated emails sent to users)
# Example on Vercel: https://wayflow-app.vercel.app or http://localhost:5173
FRONTEND_URL=https://your-frontend-deployment.vercel.app

# Optional: Pin internal system clock for demos/testing (ISO 8601 timestamp with timezone offset).
# Freezes time to 10:00 AM on Oct 4, 2026 so 4:00 PM order cutoffs don't expire during evaluation.
# Leave blank or unset to use the actual real-world server time.
WAYFLOW_NOW=2026-10-04T10:00:00+05:30
