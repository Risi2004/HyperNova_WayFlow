# WayFlow — Docker Compose configuration. Copy to .env and adjust if needed;
# every value has a working default, so `docker compose up --build` also runs without a .env.

# PostgreSQL container
POSTGRES_USER=wayflow
POSTGRES_PASSWORD=wayflow
POSTGRES_DB=wayflow

# API
API_PORT=5000
JWT_SECRET=change-me-in-production
# Address of the web app, used in links inside account e-mails
FRONTEND_URL=http://localhost:8080

# Web app (baked into the build; must be reachable from the judge's browser)
WEB_PORT=8080
VITE_API_URL=http://localhost:5000/api

# Optional: e-mail used to send new-account credentials. Leave blank to skip e-mail;
# the seeded accounts in the README work without it.
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Optional: pin the system clock for a demo (ISO timestamp), e.g. 2026-10-04T10:00:00+05:30
WAYFLOW_NOW=
